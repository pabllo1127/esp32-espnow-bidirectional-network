#include <ESP32Servo.h>
#include <DHT.h>
#include <esp_now.h>
#include <WiFi.h>
#include "esp_wifi.h"
#include <Wire.h>
#include <RTClib.h>

RTC_DS3231 rtc;

typedef struct {
  int tempThreshold;
  int humidThreshold;
  bool manualServo;
} CommandData;

typedef struct {
  float temp;
  float humidity;
  int lightval;
  bool tempHigh;
  bool humidHigh;
  bool lightAlert;
  char lightStatus[15];
  int hour;
  int minute;
} SensorData;

CommandData receivedCommand;
SensorData dataToSend;

uint8_t receiverMAC[] = {0x94, 0xA9, 0x90, 0xD1, 0xDC, 0x20};

DHT dht(4, DHT11);
Servo myServo;
int ldr = 5;
bool tempHigh = false;
bool humidHigh = false;

void OnDataSent(const wifi_tx_info_t *mac_addr, esp_now_send_status_t status) {
  Serial.println(status == ESP_NOW_SEND_SUCCESS ? "Sent OK" : "Send Failed");
}

void OnDataReceived(const esp_now_recv_info *info, const uint8_t *data, int len) {
  memcpy(&receivedCommand, data, sizeof(receivedCommand));
  Serial.println("Command received!");
  Serial.print("Temp threshold: ");
  Serial.println(receivedCommand.tempThreshold);
  Serial.print("Humid threshold: ");
  Serial.println(receivedCommand.humidThreshold);
  Serial.print("Manual servo: ");
  Serial.println(receivedCommand.manualServo);
}

String getLightStatus(int lightval, int hour) {
  if (hour >= 6 && hour < 20) {
    if (lightval > 2000) return "BRIGHT OK";
    else if (lightval > 1000) return "DIM DAY";
    else return "TOO DARK!";
  } else if (hour >= 20 && hour < 22) {
    if (lightval > 1000) return "BRIGHT EVE";
    else if (lightval > 300) return "EVENING OK";
    else return "VERY DARK";
  } else {
    if (lightval < 300) return "NIGHT OK";
    else if (lightval < 1000) return "DIM NIGHT";
    else return "TOO BRIGHT!";
  }
}

bool isLightAlert(int lightval, int hour) {
  if (hour >= 6 && hour < 20) {
    return lightval < 1000;
  } else if (hour >= 20 && hour < 22) {
    return lightval < 300 || lightval > 2000;
  } else {
    return lightval > 1000;
  }
}

void setup() {
  Serial.begin(115200);
  dht.begin();
  myServo.attach(21);
  pinMode(ldr, INPUT);

  Wire.begin(8, 9);

  if (!rtc.begin()) {
    Serial.println("RTC not found!");
  } else {
    Serial.println("RTC found!");
    rtc.adjust(DateTime(2026, 7, 25, 21, 03, 0));
  }

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  delay(100);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init failed!");
    return;
  }

  delay(100);

  esp_now_register_send_cb(OnDataSent);
  esp_now_register_recv_cb(OnDataReceived);

  esp_now_peer_info_t peerInfo = {};
  memset(&peerInfo, 0, sizeof(peerInfo));
  memcpy(peerInfo.peer_addr, receiverMAC, 6);
  peerInfo.channel = 0;
  peerInfo.encrypt = false;
  peerInfo.ifidx = WIFI_IF_STA;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Failed to add peer!");
    return;
  }

  receivedCommand.tempThreshold = 30;
  receivedCommand.humidThreshold = 60;
  receivedCommand.manualServo = false;

  Serial.println("ESP-NOW ready!");
}

void loop() {
  DateTime now = rtc.now();

  dataToSend.temp = dht.readTemperature();
  dataToSend.humidity = dht.readHumidity();
  dataToSend.lightval = analogRead(ldr);
  dataToSend.hour = now.hour();
  dataToSend.minute = now.minute();

  strncpy(dataToSend.lightStatus, getLightStatus(dataToSend.lightval, now.hour()).c_str(), 15);
  dataToSend.lightAlert = isLightAlert(dataToSend.lightval, now.hour());

  if (dataToSend.temp > receivedCommand.tempThreshold) {
    tempHigh = true;
  } else {
    tempHigh = false;
  }

  if (dataToSend.humidity > receivedCommand.humidThreshold) {
    humidHigh = true;
  } else {
    humidHigh = false;
  }

  dataToSend.tempHigh = tempHigh;
  dataToSend.humidHigh = humidHigh;

  // Debug line
  Serial.print("Manual servo command: ");
  Serial.println(receivedCommand.manualServo);

  if (tempHigh && humidHigh || receivedCommand.manualServo) {
    myServo.write(90);
  } else {
    myServo.write(0);
  }

  esp_now_send(receiverMAC, (uint8_t *)&dataToSend, sizeof(dataToSend));

  Serial.print("Time: ");
  Serial.print(now.hour());
  Serial.print(":");
  Serial.println(now.minute());
  Serial.print("Temp: "); Serial.println(dataToSend.temp);
  Serial.print("Humidity: "); Serial.println(dataToSend.humidity);
  Serial.print("Light: "); Serial.println(dataToSend.lightval);
  Serial.print("Light Status: "); Serial.println(dataToSend.lightStatus);

  delay(2000);
}
